OPENAI_API_KEY=your-openai-api-key-here
REDIS_URL=redis://localhost:6379
CHATGPT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
PDF_URL=https://sgp.fas.org/crs/misc/IF10244.pdf
PDF_PATH=./data/IF10244.pdf
FIGURES_DIR=./data/figures

# LLM provider toggle: switches the chat/vision + embedding models used across
# the whole pipeline. Just change this value (and its model names below) --
# no code changes needed.
# One of: openai, gemini, ollama, qwen
LLM_PROVIDER=openai

# Only needed when LLM_PROVIDER=gemini. Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Only used when LLM_PROVIDER=ollama. Runs fully locally, no API key needed --
# a good fallback when a cloud provider's signup isn't available in your region.
# Install Ollama (https://ollama.com) and pull the models first:
#   ollama pull qwen3-vl:2b          # vision-capable, used for chat + image summaries
#   ollama pull qwen3-embedding:0.6b # embeddings
# qwen3-vl:2b fits comfortably in ~4GB of VRAM (laptop/modest GPUs). If you
# have a stronger GPU (8GB+ VRAM), swap in qwen3-vl:4b or :8b for noticeably
# better summary quality -- check `ollama ps` after a run: if PROCESSOR shows
# a CPU/GPU split rather than 100% GPU, the model doesn't fully fit and will
# run much slower, so drop to a smaller size instead.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3-vl:2b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b

# Only needed when LLM_PROVIDER=qwen. Uses Qwen (Alibaba) via DashScope's
# OpenAI-compatible API, which has a free tier. Get a key at
# https://bailian.console.alibabacloud.com/ (mainland) or
# https://modelstudio.console.alibabacloud.com/ (international).
# Use https://dashscope.aliyuncs.com/compatible-mode/v1 for QWEN_BASE_URL
# instead if you have a mainland-China DashScope account.
QWEN_API_KEY=your-qwen-dashscope-api-key-here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-vl-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# Chunking strategy toggle, for comparing pipeline behavior across strategies.
# One of: by_title, basic, recursive, sentence, paragraph
CHUNKING_STRATEGY=by_title
MAX_CHARACTERS=4000
NEW_AFTER_N_CHARS=4000
COMBINE_TEXT_UNDER_N_CHARS=2000
