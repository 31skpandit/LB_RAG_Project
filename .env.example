OPENAI_API_KEY=your-openai-api-key-here
REDIS_URL=redis://localhost:6379
CHATGPT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# The pipeline only ever runs on documents placed in DATA_DIR -- it
# auto-discovers every supported file there (PDF, DOCX, PPTX, TXT, HTML, or a
# standalone image) and indexes all of them into one combined knowledge base.
# An empty DATA_DIR is a hard error (no silent download). PDF_URL/PDF_PATH are
# only used by the explicit --pdf-url override (see data_ingestion/downloader.py).
DATA_DIR=./data
PDF_URL=https://sgp.fas.org/crs/misc/IF10244.pdf
PDF_PATH=./data/IF10244.pdf
FIGURES_DIR=./data/figures

# LLM provider toggle: switches the chat/vision model used across the whole
# pipeline. Just change this value (and its model names below) -- no code
# changes needed.
# One of: openai, gemini, ollama, qwen, groq, deepseek
LLM_PROVIDER=openai

# Embedding provider: independent of LLM_PROVIDER, defaults to match it, so
# most setups can ignore this entirely. MUST be set explicitly to something
# other than "groq"/"deepseek" when LLM_PROVIDER is one of those -- neither
# has an embeddings API (Groq: nomic-embed-text-v1_5 404s and no embedding
# model appears in its live /v1/models list; DeepSeek's hosted API only ever
# exposed chat completions). E.g. set EMBEDDING_PROVIDER=gemini to pair fast
# Groq/DeepSeek chat with Gemini's free-tier embeddings.
EMBEDDING_PROVIDER=openai

# Only needed when LLM_PROVIDER=gemini. Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key-here
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Only used when LLM_PROVIDER=ollama. Runs fully locally, no API key needed --
# a good fallback when a cloud provider's signup isn't available in your region.
# Install Ollama (https://ollama.com) and pull the models first:
#   ollama pull qwen3-vl:2b          # vision-capable, used for chat + image summaries
#   ollama pull qwen3-embedding:0.6b # embeddings
# qwen3-vl:2b fits comfortably in ~4GB of VRAM (laptop/modest GPUs). If you
# have a stronger GPU (8GB+ VRAM), swap in qwen3-vl:4b or :8b for noticeably
# better summary quality -- check `ollama ps` after a run: if PROCESSOR shows
# a CPU/GPU split rather than 100% GPU, the model doesn't fully fit and will
# run much slower, so drop to a smaller size instead.
# To run DeepSeek locally instead: needs NO code changes, just
# `ollama pull deepseek-r1:1.5b` (fits ~4GB VRAM; bump to :7b/:8b/:14b on
# stronger hardware) and set OLLAMA_CHAT_MODEL=deepseek-r1:1.5b below -- BUT
# deepseek-r1 is text-only (no vision variant exists on Ollama), so it will
# fail if it ever needs to summarize an actual image. Safe with
# UNSTRUCTURED_STRATEGY=fast (extracts no images anyway); keep qwen3-vl/llava
# as OLLAMA_CHAT_MODEL if you switch to hi_res and need working image summaries.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3-vl:2b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Ollama's own default context window. Configurable here in case a larger
# corpus/retrieval-k ever needs more -- but note: raising this was tried as a
# fix for an empty-answer bug and did NOT fix it, while roughly tripling
# generation time (bigger KV-cache leaves less VRAM for model weights, pushing
# more layers to slow CPU fallback). Leave at 4096 unless you have solid
# evidence a bigger value is actually needed.
OLLAMA_NUM_CTX=4096

# Only needed when LLM_PROVIDER=qwen. Uses Qwen (Alibaba) via DashScope's
# OpenAI-compatible API, which has a free tier. Get a key at
# https://bailian.console.alibabacloud.com/ (mainland) or
# https://modelstudio.console.alibabacloud.com/ (international).
# Use https://dashscope.aliyuncs.com/compatible-mode/v1 for QWEN_BASE_URL
# instead if you have a mainland-China DashScope account.
QWEN_API_KEY=your-qwen-dashscope-api-key-here
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_CHAT_MODEL=qwen-vl-plus
QWEN_EMBEDDING_MODEL=text-embedding-v3

# Only needed when LLM_PROVIDER=groq. Extremely fast free-tier inference, no
# country restriction. Get a free key at https://console.groq.com/keys
# Free-tier limits (subject to change, check https://console.groq.com/docs/rate-limits):
#   qwen/gpt-oss models (incl. the vision model below): 30 RPM, 1K RPD, 8K TPM, 200K TPD
#   Output tokens specifically (OTPM) are capped tighter, at 1,000/min -- this
#   is the one you'll actually hit first. GROQ_MAX_TOKENS caps each response
#   so a single call can't exceed it (a "thinking" model like qwen3.6 spends
#   part of that budget on reasoning before its final answer, so if you see
#   empty responses rather than 429s, that cap may be too tight -- raise it a
#   bit, or lower max_concurrency in summarization/text_table_summarizer.py).
# GROQ_CHAT_MODEL must be vision-capable since it's also used for image
# summaries -- Groq's vision models are Qwen-based and marked "preview"
# (can be renamed/deprecated with little notice); check
# https://console.groq.com/docs/vision if this default 404s.
# NOTE: no GROQ_EMBEDDING_MODEL -- Groq has no embeddings API for this
# account; set EMBEDDING_PROVIDER above to use another provider's embeddings.
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=qwen/qwen3.6-27b
GROQ_MAX_TOKENS=500

# Only needed when LLM_PROVIDER=deepseek. DeepSeek's official API,
# OpenAI-compatible. Get a key at https://platform.deepseek.com/api_keys
# (pay-as-you-go, no free tier -- but rate limiting is dynamic/concurrency-based
# rather than a harsh fixed RPM like Groq/Gemini's free tiers, so it shouldn't
# need GROQ_MAX_TOKENS-style workarounds).
# DEEPSEEK_CHAT_MODEL must be vision-capable since it's also used for image
# summaries -- "deepseek-flash" supports image input; "deepseek-v4-pro"
# (higher quality, no vision, pricier) is the alternative if you don't need
# image summarization.
# NOTE: no DEEPSEEK_EMBEDDING_MODEL -- DeepSeek has no embeddings API; set
# EMBEDDING_PROVIDER above to use another provider's embeddings.
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-flash

# Partitioning strategy: "fast" reads each document's text layer directly;
# "hi_res" runs a deep-learning layout/OCR model over a rendered image of
# every page instead -- much more accurate for scanned/complex-layout
# documents, but commonly 1-3+ seconds PER PAGE on CPU, so it doesn't scale to
# large digitally-native documents. Default "fast" is right for typical
# PDFs/DOCX/PPTX with an actual text layer; switch to "hi_res" only if you're
# ingesting scanned documents or notice table-extraction quality suffering.
# One of: fast, hi_res, ocr_only, auto
UNSTRUCTURED_STRATEGY=fast

# Chunking strategy toggle, for comparing pipeline behavior across strategies.
# One of: by_title, basic, recursive, sentence, paragraph
CHUNKING_STRATEGY=by_title
MAX_CHARACTERS=4000
NEW_AFTER_N_CHARS=4000
COMBINE_TEXT_UNDER_N_CHARS=2000
